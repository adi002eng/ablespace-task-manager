generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "mysql"
}

enum TaskStatus {
  TODO
  DOING
  COMPLETED
  ON_HOLD
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  tasks     Task[]
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  assignee    String?
  dueDate     DateTime?
  tag         String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  userId String?
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
}